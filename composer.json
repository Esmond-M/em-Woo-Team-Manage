{
    "name": "esmond-m/em-woo-team-manage",
    "description": "WordPress plugin for WooCommerce team management",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "emWooTeamManage\\init_plugin\\Classes\\": "includes/classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "emWooTeamManage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "phpunit --testsuite Unit"
    }
}
