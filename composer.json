{
    "name": "esmond-m/em-woo-team-manage",
    "description": "WordPress plugin for WooCommerce team management",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "brain/monkey": "^2.6",
        "yoast/phpunit-polyfills": "^2.0",
        "squizlabs/php_codesniffer": "3.9",
        "wp-coding-standards/wpcs": "3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "1.0"
    },
    "autoload": {
        "psr-4": {
            "emWooTeamManage\\init_plugin\\Classes\\": "includes/classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "emWooTeamManage\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@test:unit",
        "test:unit": "phpunit --testsuite Unit",
        "lint": "phpcs --standard=phpcs.xml.dist",
        "lint:fix": "phpcbf --standard=phpcs.xml.dist"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
